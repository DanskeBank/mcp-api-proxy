# Copy to a file outside your project and pass it with --settings-file <path>,
# then fill in values. Variables already set in the environment win over this
# file. The proxy never reads a .env from its working directory on its own.
# Quote values that contain # or spaces: CLIENT_KEY_PASSPHRASE="p#ss phrase"
# Never commit credentials.
#
# Hosts, token endpoints and the OAuth scope are built into the package and
# cannot be set here. For the HTTP transport use the --port and --host options.

# --- Hosted MCP server ---
# Required, including production. Sent as X-API-Key.
# Get a key at https://developers.danskebank.com/mcp/apikey
MCP_SERVER_API_KEY=

# --- OAuth2 client (Premium APIs, client_credentials grant) ---
# Required for sandbox/production calls.
# Leave OAuth/mTLS settings unset for intentional mock/discovery-only operation.
# Partial auth settings produce stderr warnings naming missing variables, never values.
# Startup reports enabled/default tiers. The default remains live, then sandbox,
# then mock: complete live credentials can make the default use real data (GET only).
# The same client certificate serves the sandbox and live tiers and every Premium
# API, including the Payment Collection API.
CLIENT_ID=
# Path to PEM-encoded x509 client certificate
CLIENT_CERT_PEM=
# Path to PEM-encoded private key
CLIENT_KEY_PEM=
# Passphrase of the private key.
CLIENT_KEY_PASSPHRASE=

# Scopes to request, space-delimited. The default is "accounts payments".
# Set it only if your client is registered for fewer products, for example:
# TOKEN_SCOPE=accounts
