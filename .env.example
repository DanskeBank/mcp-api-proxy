# Copy to .env, or to any file you pass with --settings-file <path>, and fill
# in values. Variables already set in the environment win over this file.
# Quote values that contain # or spaces: CLIENT_KEY_PASSPHRASE="p#ss phrase"
# .env is gitignored; never commit credentials.

# --- API host overrides (optional) ---
# MCP_API_HOST_MOCK=
# MCP_API_HOST_SANDBOX=
# MCP_API_HOST_LIVE=

# --- HTTP transport (only when running with --transport http) ---
# MCP_HTTP_PORT=3001
# MCP_HTTP_HOST=127.0.0.1

# --- Session management (HTTP mode only) ---
# Maximum concurrent sessions before new connections get 503.
# MCP_MAX_SESSIONS=100
# Idle session TTL in milliseconds (default: 30 min). Sessions with no
# activity for this duration are automatically reaped.
# MCP_SESSION_TTL_MS=1800000
# Per-IP rate limit for new session creation (default: 10 per window).
# MCP_RATE_LIMIT_PER_IP=10
# Rate limit sliding window in milliseconds (default: 60s).
# MCP_RATE_LIMIT_WINDOW_MS=60000

# --- Upstream MCP server ---
# Defaults to https://mcp.danskebank.com/mcp.
# MCP_SERVER_URL=
# Required for the hosted MCP server, including production. Sent as X-API-Key.
# Get a key at https://developers.danskebank.com/mcp/apikey
MCP_SERVER_API_KEY=

# --- OAuth2 client (Premium APIs, client_credentials grant) ---
# Required for sandbox/production calls.
# Leave OAuth/mTLS settings unset for intentional mock/discovery-only operation.
# Partial auth settings produce stderr warnings naming missing variables, never values.
# Startup reports enabled/default tiers. The default remains live, then sandbox,
# then mock: complete live credentials can make the default use real data (GET only).
CLIENT_ID=
# Path to PEM-encoded x509 client certificate
CLIENT_CERT_PEM=
# Path to PEM-encoded private key (may be encrypted)
CLIENT_KEY_PEM=
# Optional — only if CLIENT_KEY_PEM is encrypted
# CLIENT_KEY_PASSPHRASE=

# Single OAuth2 scope. Single-product per process for now (testing).
# Restart with a different scope to access another product.
# Examples: accounts | payments
# TOKEN_SCOPE=accounts

# Override the sandbox token endpoint. Default:
# https://sandbox-api.danskebank.com/sandbox-corporate/api/dk/business/oauth2/token
# The Payment Collection API has its own:
# SANDBOX_TOKEN_URL=https://sandbox-api.danskebank.com/sandbox-corporate/api/fi/business/oauth2/token

# --- Live tier token endpoint override ---
# The live tier reuses the same CLIENT_CERT_PEM / CLIENT_KEY_PEM as sandbox.
# Default:
# https://api.danskebank.com/corporate/api/dk/business/oauth2/token
# The Payment Collection API has its own:
# LIVE_TOKEN_URL=https://api.danskebank.com/corporate/api/fi/business/oauth2/token
